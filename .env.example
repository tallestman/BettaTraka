# ==============================================================================
# BettaTraka Environment Configuration (.env)
# ==============================================================================
# Copy this template to .env before starting the server:
#   cp .env.example .env
#
# IMPORTANT:
# - Use placeholders only in this file. Never commit real production secrets.
# - Production secrets will be supplied securely on your VPS.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Environment & Network Port
# ------------------------------------------------------------------------------
# PORT: The TCP port the Node.js/Express server listens on.
PORT=3000

# NODE_ENV: Set to 'production' on your VPS, or 'development' for local work.
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# DATABASE_URL: Standard PostgreSQL connection URI.
# Format: postgresql://<USERNAME>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>
#
# Examples:
# - For Docker Compose (local dev): postgresql://bettatraka_user:YOUR_LOCAL_DB_PASSWORD@db:5432/bettatraka
#   (Note: 'db' is the private container hostname on the bettatraka-internal network)
# - For Native Host / VPS:        postgresql://bettatraka_user:YOUR_DB_PASSWORD@127.0.0.1:5432/bettatraka
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@127.0.0.1:5432/bettatraka

# DATABASE_SSL: Configures TLS/SSL encryption for the PostgreSQL connection pool.
#
# How DATABASE_SSL is parsed:
# The server evaluates the string in parseDatabaseSsl() (case-insensitive, trimmed):
#
# 1. Disabled (returns false / no TLS):
#    Accepts: 'false', '0', 'no', 'disable', 'off'
#    Use case: Local development with Docker Compose or connecting via local unix socket / loopback.
#
# 2. Permissive TLS (returns { rejectUnauthorized: false }):
#    Accepts: 'true', '1', 'yes', 'require', 'prefer', 'allow'
#    Use case: Managed cloud databases or VPS reverse tunnels with self-signed / provider-managed certificates.
#
# 3. Strict TLS (returns { rejectUnauthorized: true }):
#    Accepts: 'strict', 'verify-full', 'verify-ca'
#    Use case: High-security production environments with trusted root CA certificates.
#
# 4. Unset or empty string:
#    SSL is omitted from the pool configuration (relies on connection string parameters).
DATABASE_SSL=false

# Docker Compose helper variables (used when launching 'docker compose up')
POSTGRES_DB=bettatraka
POSTGRES_USER=bettatraka_user
POSTGRES_PASSWORD=YOUR_SECURE_POSTGRES_PASSWORD_HERE

# ------------------------------------------------------------------------------
# 3. Authentication & JWT Session Secret
# ------------------------------------------------------------------------------
# JWT_SECRET: Cryptographic key used to sign and verify HMAC-SHA256 session tokens.
#
# SECURITY REQUIREMENTS:
# - Must be a high-entropy string of at least 32 characters (256-bit security).
# - Do NOT commit real secrets to version control.
# - Do NOT use easily guessable strings.
# - The server will reject token issuance if this environment variable is missing.
#
# Generate a cryptographically secure key locally using either command:
#
# Command Option A (OpenSSL):
#   openssl rand -base64 32
#
# Command Option B (Node.js built-in crypto):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
JWT_SECRET=REPLACE_WITH_CRYPTOGRAPHICALLY_SECURE_32_CHAR_BASE64_SECRET

# ------------------------------------------------------------------------------
# 4. Cross-Origin Resource Sharing (CORS)
# ------------------------------------------------------------------------------
# CORS_ORIGIN: Allowed HTTP origin(s) for browser requests.
# - For local development: http://localhost:3000
# - For production VPS:    https://crm.yourdomain.com
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# 5. External Integration Placeholders (Optional)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
APP_URL=http://localhost:3000
